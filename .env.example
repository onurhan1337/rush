
NODE_ENV = production
NEXT_PUBLIC_GRAPH_API_URL = https://api.myikas.com/api/v2/admin/graphql
NEXT_PUBLIC_ADMIN_URL = https://{storeName}.myikas.com/admin
NEXT_PUBLIC_DEPLOY_URL = http://localhost:3000

SECRET_COOKIE_PASSWORD = your_session_cookie_password_here
NEXT_PUBLIC_CLIENT_ID = your_store_app_id_here
CLIENT_SECRET = your_store_app_secret_here

# Secret used to derive per-merchant public keys embedded in the storefront widget tag
RUSH_PUBLIC_KEY_SECRET = your_random_32_byte_hex_secret_here

# Postgres. DATABASE_URL is the pooled connection used by the app; DIRECT_URL is the
# unpooled one migrations need. On Neon the two differ only by the "-pooler" host suffix.
DATABASE_URL = postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL = postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require
